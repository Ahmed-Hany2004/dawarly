model SubCategory {
  id           String                   @id @default(uuid())
  key          String // sell, rent
  categoryName String

  translations SubCategoryTranslation[]
  attributes   AttributeDefinition[]

 houses House[]
  rents  Properties_for_rent[]
  @@index([categoryName])
}

model SubCategoryTranslation {
  id            String @id @default(uuid())
  lang          String
  name          String
  subCategoryId String

  subCategory SubCategory @relation(fields: [subCategoryId], references: [id], onDelete: Cascade)

  @@unique([subCategoryId, lang])
  @@index([subCategoryId])
}

model AttributeDefinition {
  id            String   @id @default(uuid())
  key           String   // furnishing, rooms
  type          String   // number, select, date
  required      Boolean  @default(false)
  filterable    Boolean  @default(true)

  subCategoryId String
  subCategory   SubCategory @relation(fields: [subCategoryId], references: [id], onDelete: Cascade)

  translations  AttributeTranslation[]
  options       AttributeOption[]
}


model AttributeTranslation {
  id          String @id @default(uuid())
  lang        String
  label       String
  attributeId String

  attribute   AttributeDefinition @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@unique([attributeId, lang])
}


model AttributeOption {
  id           String @id @default(uuid())
  value        String

  attributeId  String
  attribute    AttributeDefinition @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  translations AttributeOptionTranslation[]

  @@index([attributeId])
  @@unique([attributeId, value])
}



model AttributeOptionTranslation {
  id        String @id @default(uuid())
  lang      String
  label     String
  optionId String

  option    AttributeOption @relation(fields: [optionId], references: [id] ,onDelete: Cascade)

  @@unique([optionId, lang])
}
